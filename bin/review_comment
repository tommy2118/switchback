#!/usr/bin/env ruby
# Writes the pull request comment for a ticket from its acceptance tests' verbose output. It says only what the
# tests proved: each criterion passed, failed, or crashed before it could be checked.
# Usage: review_comment <ticket number> <test output file>
require "yaml"

ticket, output_path = ARGV
output = File.read(output_path)
root = File.expand_path("..", __dir__)
folder = File.join(root, "tickets", ticket)
# A browser test can print between a test's name and its result, such as where it saved a screenshot.
marks = output.scan(/^Ticket\d+Test#(test_.+?) = (?:.*\n)*?[\d.]+ s = ([.FES])$/).to_h
# Minitest prints each problem as "Failure:" or "Error:", the test's name, then its message.
messages = output.scan(/^(?:Failure|Error):\nTicket\d+Test#(test_\S.*?)(?: \[.*?\])?:\n(.+)$/).to_h
criteria = File.read(File.join(folder, "acceptance_test.rb")).scan(/^\s*test "(.+)" do$/).flatten
results = criteria.filter_map do |criterion|
  name = "test_#{criterion.gsub(/\s+/, "_")}"
  [ criterion, marks[name], messages[name] ] if marks.key?(name)
end

puts "## Ticket #{ticket}: CI review", ""
if results.empty?
  puts "The acceptance tests couldn't run, so there's nothing to review yet. The end of their output:", "",
       "````", output.lines.last(25).join.strip, "````"
  exit
end

results.each do |criterion, mark, message|
  icon = { "." => "✅", "F" => "❌", "E" => "💥" }.fetch(mark, "❌")
  puts "#{icon} #{criterion}"
  puts "<details><summary>Why</summary>", "", "````", message.strip, "````", "</details>" if message
end
passed = results.count { it[1] == "." }
crashed = results.select { it[1] == "E" }
puts ""
if passed == results.size
  puts "Every acceptance criterion passes. Before approving, a human reviewer would still ask:", ""
  puts File.read(File.join(folder, "reviewer.md")).strip
elsif crashed.any?
  puts "#{passed} of #{results.size} criteria pass. 💥 means the app raised an error before the test could check " \
       "anything, so the fix has a problem of its own. Open \"Why\" to see the error."
  hints_path = File.join(folder, "hints.yml")
  hints = File.exist?(hints_path) ? YAML.load_file(hints_path) : []
  hints.select { |hint| crashed.any? { it[2].to_s.include?(hint["match"]) } }.each { puts "", "**Hint:** #{it["hint"]}" }
else
  puts "#{passed} of #{results.size} criteria pass. Each ❌ is something the hiker still runs into. Open \"Why\" to " \
       "see what the test expected."
end
puts "", "<sub>This review says only what the ticket's acceptance tests prove.</sub>"
