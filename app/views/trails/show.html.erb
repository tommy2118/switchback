<% content_for :title, "#{@trail.name} · Switchback" %>
<%= turbo_stream_from @trail %>
<h1 class="text-3xl font-bold"><%= @trail.name %></h1>
<p class="text-stone-500"><%= @trail.miles %> mi · <%= number_with_delimiter(@trail.gain_feet) %> ft gain · <%= @trail.difficulty %></p>

<% if authenticated? %>
  <div class="mt-3">
    <% if @trail.follows.exists?(user: Current.user) %>
      <%= button_to "Unfollow", trail_follow_path(@trail), method: :delete, class: "text-sm text-stone-600 underline" %>
    <% else %>
      <%= button_to "Follow this trail", trail_follow_path(@trail), class: "text-sm text-emerald-800 underline" %>
    <% end %>
  </div>
  <%= form_with model: [ @trail, @note ], class: "mt-6 flex gap-3", data: { controller: "character-count", character_count_limit_value: Note::BODY_LIMIT } do |form| %>
    <div class="flex-1">
      <%= form.text_area :body, rows: 2, placeholder: "How was the trail?", class: "w-full rounded border border-stone-300 p-2",
            aria: { describedby: "note_body_count" }, data: { character_count_target: "input", action: "character-count#update" } %>
      <p id="note_body_count" class="text-sm text-stone-500" data-character-count-target="count">Up to <%= Note::BODY_LIMIT %> characters.</p>
      <p class="sr-only" aria-live="polite" data-character-count-target="announcement"></p>
    </div>
    <%= form.submit "Post note", class: "self-start rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
<% else %>
  <p class="mt-6"><%= link_to "Sign in", new_session_path, class: "underline" %> to leave a note.</p>
<% end %>

<h2 class="mt-8 font-semibold text-stone-500">Trail notes</h2>
<div id="notes" class="mt-2 space-y-2">
  <%= render @trail.notes %>
</div>
